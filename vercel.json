{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hpeventwear.id.vn" }],
      "destination": "https://www.hpeventwear.id.vn/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
